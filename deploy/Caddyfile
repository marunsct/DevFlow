# The TLS front of a production deployment (docker-compose.prod.yml, LR.11). Set SITE_ADDRESS to the host name people
# use; Caddy gets and renews its certificate. For a machine with no public name, `SITE_ADDRESS=:443` with `tls internal`
# below serves a certificate from Caddy's own authority, which browsers must be told to trust once.
{$SITE_ADDRESS:localhost} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' wss:; frame-src 'self' {$PRODUCT_PREVIEW_ORIGIN:https://preview.localhost}; frame-ancestors 'none'"
	}
	reverse_proxy app:8000
}

# Product previews (plan UX.9, switch PRODUCT_PREVIEW): an origin of their own, so a product's page keeps its own
# storage and cookies and never runs with the app's. PRODUCT_PREVIEW_ORIGIN is the value the app reads too:
# `https://preview.<site>` (the default), or `https://*.preview.<site>` for one host per run where DNS and TLS cover
# the wildcard (a public wildcard name needs a Caddy build with a DNS-challenge module). Keep it a sub-domain of the
# app's site: the framed page's cookies are then first-party. Only a preview's own paths are passed on, unbuffered, so
# event streams and WebSockets work; the app sets the page's own security headers.
{$PRODUCT_PREVIEW_ORIGIN:https://preview.localhost} {
	@preview path_regexp ^/api/runs/[^/]+/preview/app/
	handle @preview {
		reverse_proxy app:8000 {
			flush_interval -1
		}
	}
	handle {
		respond "A preview origin serves previews only." 404
	}
}
