{
  "name": "simple-to-do-list-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "mkdir -p test-results && node --import ./test-setup.mjs --test --test-timeout=20000 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=test-results/unit.xml 'tests/**/{test,test-*,*[._-]test}.{js,mjs,cjs}'",
    "test:acceptance": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "axe-core": "4.14.0",
    "jsdom": "26.1.0"
  }
}
