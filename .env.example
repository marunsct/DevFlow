# Copy to .env and fill in. Every value marked REQUIRED must be set: the stack
# refuses to start without them rather than falling back to an insecure default.

# --- Security (REQUIRED) ---------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
# Initial admin account password.
ADMIN_PASSWORD=
# Postgres superuser password.
POSTGRES_PASSWORD=

# production | development. Anything other than a development value requires
# the secrets above to be set explicitly.
ENV=production

# Comma-separated browser origins allowed to call the API. Leave empty when the
# frontend is served from the same origin as the API.
ALLOWED_ORIGINS=
# CIDRs of proxies whose X-Forwarded-For may be trusted for rate limiting.
TRUSTED_PROXIES=
# Bearer token Prometheus presents when scraping /metrics. Empty leaves the
# endpoint unauthenticated, which is fine on a private metrics port.
METRICS_SCRAPE_TOKEN=

# --- Database and cache ----------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_DB=langchain
# Postgres keeps checkpoints reachable from both the API and the worker.
CHECKPOINTER_TYPE=postgres

# --- Agent execution -------------------------------------------------------
# Off by default. Enabling it lets agents run commands in a sandbox container,
# which requires DOCKER_SOCKET below. Access to the Docker socket is equivalent
# to root on the host: only enable this on dedicated worker nodes.
ALLOW_COMMAND_EXECUTION=false
# DOCKER_SOCKET=/var/run/docker.sock
SANDBOX_MEMORY_LIMIT=2g
SANDBOX_CPU_LIMIT=2
SANDBOX_PIDS_LIMIT=512

# --- Model providers -------------------------------------------------------
# local | openai | anthropic | gemini
LLM_PROVIDER=local
OPENAI_BASE_URL=http://host.docker.internal:1234/v1
OPENAI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# GOOGLE_API_KEY is canonical; GEMINI_API_KEY is accepted as an alias.
GOOGLE_API_KEY=
# Restrict which hosts the base URL may point at, so a settings change cannot
# redirect model traffic (and its credentials) to an arbitrary server.
ALLOWED_MODEL_HOSTS=

# Fallback models used when the primary provider fails.
OPENAI_FALLBACK_MODEL=gpt-4o-mini
ANTHROPIC_FALLBACK_MODEL=claude-haiku-4-5-20251001

# --- Sizing ----------------------------------------------------------------
WEB_CONCURRENCY=4
CELERY_CONCURRENCY=2
CELERY_TASK_TIME_LIMIT=3600

# --- Tracing (optional) ----------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=product-development-workflow

# ---------------------------------------------------------------------------
# Object storage (MinIO in compose; any S3-compatible service in cloud)
# ---------------------------------------------------------------------------
# Durable storage for uploads and run artifacts. The workspace itself stays on
# the filesystem - agents need a real working tree - so this is a second copy,
# and it is what lets a worker on another node read a file the API received.
# Leave OBJECT_STORE_BUCKET empty to use the local filesystem instead.
OBJECT_STORE_BUCKET=langchain-artifacts
OBJECT_STORE_ENDPOINT=http://minio:9000
OBJECT_STORE_SECURE=false
# MinIO refuses to start without a root password. Generate one:
#   openssl rand -base64 24
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=

# ---------------------------------------------------------------------------
# Seeding a workspace from an existing codebase (brownfield runs)
# ---------------------------------------------------------------------------
# Transports a clone URL may use. Empty means https only. `ext::` is never
# permitted regardless: it executes its argument as the transport.
SEED_ALLOWED_SCHEMES=
# Whether a clone may target a private, loopback or link-local address. Off by
# default: the server can reach this API, sibling containers, and the cloud
# metadata service at 169.254.169.254. Turn on only for an internal git server.
SEED_ALLOW_PRIVATE_HOSTS=false
# Ceilings on a materialised codebase.
SEED_MAX_BYTES=2147483648
MAX_CODEBASE_ARCHIVE_BYTES=209715200
# Host-side ports for MinIO's S3 API and console. Change these if 9000/9001 are
# already taken; nothing inside the stack uses them (app and worker reach MinIO
# by service name on the compose network).
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------------------------------------------------------------------------
# Provider credentials set through the Settings page
# ---------------------------------------------------------------------------
# API keys entered in the UI are stored encrypted in Postgres, never returned by
# the API, and never written to the audit log. This key encrypts them. If it is
# empty the key is derived from JWT_SECRET_KEY instead, which works but couples
# the two: rotating the JWT secret makes stored credentials unreadable until an
# administrator re-enters them. Generate one:
#   python -c 'import secrets; print(secrets.token_hex(32))'
SETTINGS_ENCRYPTION_KEY=
# Set to true to refuse all provider and credential changes through the API, so
# configuration comes only from the deployment.
SETTINGS_READ_ONLY=

# ---------------------------------------------------------------------------
# Command execution
# ---------------------------------------------------------------------------
# Whether specialists may run build and test commands at all.
ALLOW_COMMAND_EXECUTION=false
# container    - one locked-down throwaway container per command. Needs a
#                container runtime reachable from the worker, which in Docker
#                means mounting the daemon socket - and that socket is
#                root-equivalent on the host.
# in-container - run directly in the worker container as the unprivileged user,
#                in the run's workspace. Weaker isolation of the command (it can
#                reach what the worker can, including other runs' workspaces)
#                but no access to the host at all.
SANDBOX_EXECUTION_MODE=container
SANDBOX_MEMORY_LIMIT=2g
SANDBOX_CPU_LIMIT=2

# ---------------------------------------------------------------------------
# Context compaction
# ---------------------------------------------------------------------------
# An agent's conversation is summarised once it passes
# CTX_MAX_TOKENS * CTX_SOFT_TRIGGER_RATIO, keeping the most recent
# CTX_KEEP_MESSAGES intact. Set CTX_MAX_TOKENS to the usable input window of
# the model you serve.
CTX_COMPACTION_ENABLED=true
CTX_MAX_TOKENS=75000
CTX_SOFT_TRIGGER_RATIO=0.8
CTX_KEEP_MESSAGES=20
CTX_SUMMARY_BUDGET=4000
# Empty means summarise with the run's own model. A value here is resolved
# through the same factory, so it inherits the base URL and credentials.
CTX_COMPACTION_MODEL=
# Characters of the uploaded documents sent to the architect's first request.
# 0 sends everything.
CTX_ARCHITECT_DOCUMENT_BUDGET=40000
# Where compaction scratch space and oversized tool output are kept. Both
# default under DATA_DIR and are deliberately outside the run workspace, which
# is treated as product output.
CTX_STORE_ROOT=
CTX_JOURNAL_ROOT=

# ---------------------------------------------------------------------------
# Retention policy for journal entries and context-store evictions
# ---------------------------------------------------------------------------
# Age-based pruning (hours). Files older than this many hours are removed by
# the terminal-stage scratch pruner. 72 h ≈ 3 days, long enough for a team to
# revisit any run before history is purged.
CTX_JOURNAL_RETENTION_HOURS=72
CTX_CONTEXT_RETENTION_HOURS=72

# ---------------------------------------------------------------------------
# Specification bounding for agent first-messages
# ---------------------------------------------------------------------------
# Maximum characters of the technical specification to interpolate into an
# agent's very first message (the only message before any summarisation can
# rescue the budget). 0 = unlimited. Default 60 000 keeps a single spec
# under ~15 % of a 75k window.
CTX_SPECIFICATION_BUDGET=60000

# Live agent activity in the dashboard: one event per assistant message, tool
# call and tool result. Never per token. Set to false to silence it.
STREAM_AGENT_ACTIVITY=true

# Auto-approvals one stage may take before the run is stopped. WORKFLOW_MAX_GATES
# bounds the whole run; this bounds a single gate, which is where the expensive
# failure actually is - an agent re-requesting the same write forever, each
# attempt costing a model call.
WORKFLOW_MAX_GATES_PER_STAGE=25
