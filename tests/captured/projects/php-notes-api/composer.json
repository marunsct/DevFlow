{
  "name": "app/notes-api",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "slim/slim": "^4.15",
    "slim/psr7": "^1.8",
    "monolog/monolog": "^3.7"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "NotesApi\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true
  }
}
